# Kopiere diese Datei nach .env und trage deine echten Keys ein.
# .env wird NIE committet (steht in .gitignore).

# --- Pflicht ---
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
# Voice-ID aus deinem ElevenLabs-Dashboard (Voices -> Stimme -> "ID kopieren")
ELEVENLABS_VOICE_ID=

# --- Optional (Defaults in Klammern) ---
# Claude-Modell (claude-sonnet-5)
# CLAUDE_MODEL=claude-sonnet-5
# Denkaufwand: low | medium | high (low = schnellste Antworten fuer Sprache)
# CLAUDE_EFFORT=low
# Anzahl gemerkter Gespraechs-Turns (10)
# HISTORY_TURNS=10

# ElevenLabs TTS-Modell (eleven_flash_v2_5)
#   eleven_flash_v2_5      -> sehr geringe Latenz, gute Qualitaet (schnelle Antworten)
#   eleven_multilingual_v2 -> hoehere Qualitaet, etwas langsamer
#   eleven_v3              -> ausdrucksstaerkste Stimme, langsamer
# ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
# ElevenLabs STT-Modell (scribe_v2)
# ELEVENLABS_STT_MODEL=scribe_v2
# Sprache fuer Erkennung und Ausgabe, ISO-639-1 (de)
# LANGUAGE=de

# Push-to-Talk
#   hold  -> Taste gedrueckt halten (globaler Hotkey via pynput)
#   enter -> Enter startet, Enter stoppt (nur im Terminal, funktioniert ueberall)
# PTT_MODE=hold
# Taste fuer hold-Modus: space, f9, f8, ctrl_r, alt_r ... (space)
# PTT_KEY=space

# Mikrofon-Samplerate in Hz (16000)
# SAMPLE_RATE=16000
# Eingabegeraet (Name oder Index, leer = Systemstandard)
# INPUT_DEVICE=
